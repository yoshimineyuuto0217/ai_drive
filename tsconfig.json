{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "../ai_drive/backend/dist",
    "rootDir": "../ai_drive/backend/src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["../ai_drive/backend/src/**/*"],
  "exclude": ["../ai_drive/backend/node_modules", "../ai_drive/backend/dist"]
}
